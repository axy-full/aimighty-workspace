# Local development uses isolated SQLite files and mock media providers.
# Copy to .env.development.local. Never put production credentials here.
ENGINE_MOCK=1
APP_ORIGIN=http://localhost:4551
PLATFORM_DATABASE_URL=file:.data/platform-dev.db
TURSO_DATABASE_URL=file:.data/legacy-dev.db

# Production / preview: use a DIFFERENT platform database and Turso group per environment.
# Store these only in Vercel environment settings; never share production tokens with preview.
# PLATFORM_AUTH_TOKEN=
# TURSO_AUTH_TOKEN=
# TURSO_API_TOKEN=
# TURSO_ORG=
# TURSO_GROUP=
# KEYRING_SECRET=   # random secret, at least 32 characters; keep stable and backed up
# BLOB_READ_WRITE_TOKEN=
# CRON_SECRET=
# Background dispatch is native (/api/worker) in production when CRON_SECRET and
# APP_ORIGIN are set. Inngest is optional: DISPATCH_MODE=inngest plus both keys.
# DISPATCH_MODE=
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# Email verification, invitations and password resets (verified sender).
# RESEND_API_KEY=
# MAIL_FROM=
# APP_ORIGIN=https://your-canonical-domain.example

# Online subscriptions: Stripe test keys ONLY in development/preview.
# Activate live keys/webhooks only after account activation and sandbox verification.
PAYMENT_PROVIDER=manual
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Production media engines. ENGINE_MOCK must be unset/0 in production.
# ARK_API_KEY=
# GEMINI_API_KEY=
# FAL_KEY=
# ELEVENLABS_API_KEY=
# Higgsfield Soul ID training uses an API key ID + secret, server-side only.
# HF_CREDENTIALS=KEY_ID:KEY_SECRET
# Alternatively configure HF_API_KEY_ID and HF_API_KEY_SECRET separately.
# Soul Character generation is unavailable until account access and both rates
# are verified through Higgsfield's authenticated estimate endpoint.
# HF_SOUL_CHARACTER_ENABLED=1
# HF_SOUL_CHARACTER_USD_720P=
# HF_SOUL_CHARACTER_USD_1080P=
# STILLS_VIA=google
# Vercel AI Gateway uses the deployment identity unless an explicit key is configured.
# OPENAI_API_KEY=  # Server-only. OpenAI models use this direct connection when configured.
# ASTRA_BLENDER_SNAPSHOT_ID=  # Verified Blender snapshot; see docs/astra-blender-runtime.md
# ASTRA_BLENDER_RATE_CARD=  # Reviewed JSON compute rates; never inferred by the renderer.
# SUPER_ADMIN_EMAIL=
