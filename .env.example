# Local development uses isolated SQLite files and mock media providers.
# Copy to .env.development.local. Never put production credentials here.
ENGINE_MOCK=1
APP_ORIGIN=http://localhost:4551
PLATFORM_DATABASE_URL=file:.data/platform-dev.db
TURSO_DATABASE_URL=file:.data/legacy-dev.db

# Production / preview: use a DIFFERENT platform database and Turso group per environment.
# Store these only in Vercel environment settings; never share production tokens with preview.
# PLATFORM_AUTH_TOKEN=
# TURSO_AUTH_TOKEN=
# TURSO_API_TOKEN=
# TURSO_ORG=
# TURSO_GROUP=
# KEYRING_SECRET=   # random secret, at least 32 characters; keep stable and backed up
# BLOB_READ_WRITE_TOKEN=
# CRON_SECRET=
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# Email verification, invitations and password resets (verified sender).
# RESEND_API_KEY=
# MAIL_FROM=
# APP_ORIGIN=https://your-canonical-domain.example

# Online subscriptions: Stripe test keys ONLY in development/preview.
# Activate live keys/webhooks only after account activation and sandbox verification.
PAYMENT_PROVIDER=manual
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Production media engines. ENGINE_MOCK must be unset/0 in production.
# ARK_API_KEY=
# GEMINI_API_KEY=
# FAL_KEY=
# ELEVENLABS_API_KEY=
# STILLS_VIA=google
# Vercel AI Gateway uses the deployment identity unless an explicit key is configured.
# SUPER_ADMIN_EMAIL=
