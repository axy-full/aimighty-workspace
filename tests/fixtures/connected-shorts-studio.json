   "name": "shorts_studio_create",
   "description": "Start a Shorts Studio short: restyle one uploaded source video (4s-120s). PAID. Returns a session with empty job_ids; poll shorts_studio_status. Set get_cost=true with duration_seconds to estimate the credit cost without submitting a job.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "aspect_ratio": {
      "type": "string",
      "enum": [
       "9:16",
       "16:9"
      ]
     },
     "duration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 120
     },
     "get_cost": {
      "type": "boolean"
     },
     "preset_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
     },
     "preset_source": {
      "type": "string",
      "enum": [
       "cms",
       "user"
      ]
     },
     "resolution": {
      "type": "string",
      "const": "720p"
     },
     "source_video_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
     }
    }
   }
  },
  {
   "name": "shorts_studio_status",
   "description": "Poll one Shorts Studio session. Returns {id, status, job_ids}. status='completed' means every clip job is terminal (not necessarily successful). Poll each job_id via job_status.",
   "inputSchema": {
    "type": "object",
    "required": [
     "session_id"
    ],
    "properties": {
     "session_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
     }
    }
   }
  }
 ],
