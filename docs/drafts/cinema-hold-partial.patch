-  if (sane(reportedUsd)) return reportedUsd;
-  if (sane(deliveredUsd)) return deliveredUsd;
-  return quoteUsd;
+  return cinemaStudioSettlement(quoteUsd, deliveredUsd, reportedUsd).usd;
+}
+
+/** What a take says when the provider's figure passed what was approved. */
+export function cinemaStudioStoppedMessage(approvedCredits: number): string {
